                    title: "(c) Гибкая композиционная модель:",
                    paragraphs: [
                      "1000+1 упражнение для импровизированного телесного взаимодействия — открытая модель создания и адаптации упражнений, ориентированных на переживание, вместо следования фиксированным техникам."
                    ]
                  }
                ],
                closingParagraphs: [
                  "Эти оригинальные понятия и их взаимосвязи подробно раскрываются в Книге C «Пути к пониманию динамики проживаемого опыта»."
                ]
              }
            ]
          }
        },
        nav: [
          { title: "Главная страница", action: "front" },
          { title: "1. Природа PSP", action: "category", categoryId: "nature", note: "1.1–1.6" },
          { title: "2. Что означают буквы PSP", action: "category", categoryId: "letters", note: "P · S · P" },
          { title: "3. Концептуальные и теоретические основания", action: "category", categoryId: "foundations", note: "3.1–3.4" },
          { title: "Области применения", note: "Готово к вставке" },
          { title: "Основатель и истоки", note: "Готово к вставке" },
          { title: "Публикации и ресурсы", note: "Готово к вставке" }
        ]
      }
    };

    let currentLang = "en";
    let activeCategoryId = null;
    let simWidth = "full";
    let simZoom = 1;

    const siteShell = document.querySelector(".site-shell");
    const frontStage = document.getElementById("frontStage");
    const heroLines = document.getElementById("heroLines");
    const categoryReader = document.getElementById("categoryReader");
    const readerTitle = document.getElementById("readerTitle");
    const readerProgress = document.getElementById("readerProgress");
    const readerPassages = document.getElementById("readerPassages");
    const navDrawer = document.getElementById("navDrawer");
    const navList = document.getElementById("navList");
    const infoModal = document.getElementById("infoModal");
    const modalTitle = document.getElementById("modalTitle");
    const modalBody = document.getElementById("modalBody");
    const backdrop = document.getElementById("backdrop");
    const programmesSlot = document.getElementById("programmesSlot");

    function fitIntroLines() {
      const spans = heroLines.querySelectorAll("span");
      if (!spans.length) return;
      const containerWidth = siteShell ? siteShell.clientWidth : window.innerWidth;
      const isDesktop = containerWidth >= 768;
      const baseSize = isDesktop ? 19 : 14.5;
      const minSize = 7.5;
      const maxWidth = containerWidth - 16;

      spans.forEach((span) => {
        span.style.fontSize = baseSize + "px";
      });

      let currentSize = baseSize;
      while (currentSize > minSize) {
        let overflows = false;
        spans.forEach((span) => {
          if (span.scrollWidth > maxWidth) {
            overflows = true;
          }
        });
        if (!overflows) break;
        currentSize = Math.round((currentSize - 0.25) * 100) / 100;
        spans.forEach((span) => {
          span.style.fontSize = currentSize + "px";
        });
      }
    }

    function applyPreviewSim(nextWidth, nextZoom, autoFit = false) {
      simWidth = nextWidth;
      let resolvedZoom = nextZoom;

      if (autoFit && simWidth !== "full") {
        const numericW = Number(simWidth);
        const availW = window.innerWidth - 24;
        if (numericW > availW) {
          resolvedZoom = Math.max(0.4, Math.floor((availW / numericW) * 20) / 20);
        } else {
          resolvedZoom = 1;
        }
      }

      simZoom = resolvedZoom;
      const isSim = simWidth !== "full" || simZoom !== 1;
      document.body.classList.toggle("sim-active", isSim);

      if (siteShell) {
        siteShell.style.width = simWidth === "full" ? "100%" : simWidth + "px";
        siteShell.style.maxWidth = "none";
        siteShell.style.minHeight = simWidth === "full" ? "100dvh" : "844px";
        siteShell.style.transform = simZoom === 1 ? "none" : `scale(${simZoom})`;
      }

      document.querySelectorAll("[data-sim-width]").forEach((btn) => {
        btn.classList.toggle("active", btn.dataset.simWidth === String(simWidth));
      });
      document.querySelectorAll("[data-sim-zoom]").forEach((btn) => {
        btn.classList.toggle("active", Math.abs(Number(btn.dataset.simZoom) - simZoom) < 0.01);
      });

      if (!activeCategoryId) {
        requestAnimationFrame(fitIntroLines);
      }
    }

    function renderCategory(categoryId) {
      const cat = content[currentLang].categories[categoryId];
      if (!cat) return;
      activeCategoryId = categoryId;
      frontStage.classList.add("hidden");
      categoryReader.classList.add("active");
      document.getElementById("backFrontBtn").textContent = content[currentLang].backFront;
      readerTitle.textContent = cat.title;
      readerProgress.textContent = cat.progress || "";

      readerPassages.innerHTML = cat.passages
        .map(
          (p) => `
          <article class="passage-block">
            <h2 class="passage-heading">${p.heading}</h2>
            ${(p.paragraphs || []).map((para) => `<p class="passage-paragraph">${para}</p>`).join("")}
            ${
              p.bullets
                ? `<ul class="passage-list">${p.bullets.map((b) => `<li>${b}</li>`).join("")}</ul>`
                : ""
            }
            ${
              p.subgroups
                ? p.subgroups
                    .map(
                      (sg) => `
                      <div class="passage-subgroup">
                        <div class="passage-subgroup-title">${sg.title}</div>
                        ${(sg.paragraphs || []).map((para) => `<p class="passage-paragraph">${para}</p>`).join("")}
                        ${
                          sg.bullets
                            ? `<ul class="passage-list">${sg.bullets.map((b) => `<li>${b}</li>`).join("")}</ul>`
                            : ""
                        }
                      </div>
                    `
                    )
                    .join("")
                : ""
            }
            ${(p.closingParagraphs || []).map((para) => `<p class="passage-paragraph">${para}</p>`).join("")}
          </article>
        `
        )
        .join("");

      window.scrollTo({ top: 0, behavior: "smooth" });
      renderNavDrawer();
    }

    function showFrontPage() {
      activeCategoryId = null;
      categoryReader.classList.remove("active");
      frontStage.classList.remove("hidden");
      requestAnimationFrame(fitIntroLines);
      renderNavDrawer();
    }

    function renderNavDrawer() {
      const dict = content[currentLang];
      navList.innerHTML = "";
      dict.nav.forEach((item) => {
        const li = document.createElement("li");
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "nav-item-btn";
        if (
          (item.action === "front" && activeCategoryId === null) ||
          (item.action === "category" && item.categoryId === activeCategoryId)
        ) {
          btn.classList.add("active");
        }

        const titleSpan = document.createElement("span");
        titleSpan.textContent = item.title;
        btn.appendChild(titleSpan);

        if (item.note) {
          const noteSpan = document.createElement("span");
          noteSpan.className = "nav-item-note";
          noteSpan.textContent = item.note;
          btn.appendChild(noteSpan);
        }

        btn.addEventListener("click", () => {
          closeOverlays();
          if (item.action === "front") {
            showFrontPage();
          } else if (item.action === "category" && item.categoryId) {
            renderCategory(item.categoryId);
          } else {
            openModal(item.title, `<p>${item.note}</p>`);
          }
        });

        li.appendChild(btn);
        navList.appendChild(li);
      });
    }

    function setLanguage(lang) {
      if (!content[lang]) return;
      currentLang = lang;
      const dict = content[lang];

      document.querySelectorAll(".lang-btn").forEach((btn) => {
        btn.classList.toggle("active", btn.dataset.lang === lang);
      });

      document.getElementById("menuLabel").textContent = dict.menuLabel;
      document.getElementById("contactBtn").textContent = dict.contactLabel;
      document.getElementById("privacyBtn").textContent = dict.privacyLabel;
      document.getElementById("programmesBtn").textContent = dict.programmes;
      document.getElementById("drawerContactBtn").textContent = dict.drawerContact;
      document.getElementById("toggleProgrammesBtn").textContent = dict.toggleProgrammes;

      heroLines.innerHTML = dict.lines.map((line) => `<span>${line}</span>`).join("");
      requestAnimationFrame(fitIntroLines);

      if (activeCategoryId) {
        renderCategory(activeCategoryId);
      } else {
        renderNavDrawer();
      }
    }

    function openDrawer() {
      closeOverlays();
      navDrawer.classList.add("open");
      navDrawer.setAttribute("aria-hidden", "false");
      backdrop.classList.add("open");
    }

    function openModal(title, htmlContent) {
      closeOverlays();
      modalTitle.textContent = title;
      modalBody.innerHTML = htmlContent;
      infoModal.classList.add("open");
      infoModal.setAttribute("aria-hidden", "false");
      backdrop.classList.add("open");
    }

    function closeOverlays() {
      navDrawer.classList.remove("open");
      navDrawer.setAttribute("aria-hidden", "true");
      infoModal.classList.remove("open");
      infoModal.setAttribute("aria-hidden", "true");
      backdrop.classList.remove("open");
    }

    function openContactModal() {
      const dict = content[currentLang];
      openModal(
        dict.contactHeading,
        `<p>${dict.contactText}</p>
         <div class="contact-email-box">
           <span id="pspEmailText">info@psp-approach.org</span>
           <button type="button" class="copy-btn" id="copyEmailBtn">${dict.copyLabel}</button>
         </div>`
      );
      const copyBtn = document.getElementById("copyEmailBtn");
      if (copyBtn) {
        copyBtn.addEventListener("click", () => {
          const tempInput = document.createElement("input");
          tempInput.value = "info@psp-approach.org";
          document.body.appendChild(tempInput);
          tempInput.select();
          document.execCommand("copy");
          document.body.removeChild(tempInput);
          copyBtn.textContent = dict.copiedLabel;
        });
      }
    }

    document.querySelectorAll(".lang-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        setLanguage(btn.dataset.lang);
      });
    });

    document.getElementById("menuBtn").addEventListener("click", openDrawer);
    document.getElementById("closeDrawerBtn").addEventListener("click", closeOverlays);
    document.getElementById("closeModalBtn").addEventListener("click", closeOverlays);
    backdrop.addEventListener("click", closeOverlays);

    document.getElementById("backFrontBtn").addEventListener("click", showFrontPage);

    document.getElementById("contactBtn").addEventListener("click", openContactModal);
    document.getElementById("drawerContactBtn").addEventListener("click", openContactModal);

    document.getElementById("privacyBtn").addEventListener("click", () => {
      const dict = content[currentLang];
      openModal(dict.privacyTitle, `<p>${dict.privacyBody}</p>`);
    });

    document.getElementById("programmesBtn").addEventListener("click", () => {
      const dict = content[currentLang];
      openModal(dict.programmesTitle, `<p>${dict.programmesBody}</p>`);
    });

    document.getElementById("toggleProgrammesBtn").addEventListener("click", () => {
      programmesSlot.classList.toggle("visible");
      closeOverlays();
    });

    document.getElementById("openSimToolbarBtn").addEventListener("click", () => {
      document.body.classList.add("sim-toolbar-open");
      closeOverlays();
    });

    document.querySelectorAll("[data-sim-width]").forEach((btn) => {
      btn.addEventListener("click", () => {
        applyPreviewSim(btn.dataset.simWidth, simZoom, true);
      });
    });

    document.querySelectorAll("[data-sim-zoom]").forEach((btn) => {
      btn.addEventListener("click", () => {
        applyPreviewSim(simWidth, Number(btn.dataset.simZoom), false);
      });
    });

    document.getElementById("simExitBtn").addEventListener("click", () => {
      applyPreviewSim("full", 1, false);
      document.body.classList.remove("sim-toolbar-open");
    });

    window.addEventListener("resize", () => {
      if (!activeCategoryId) {
        fitIntroLines();
      }
    });

    function replayLogoAnimation() {
      const svg = document.querySelector(".logo-svg");
      if (!svg) return;
      const animatedEls = svg.querySelectorAll(
        ".anim-black-crescent, .anim-gold-crescent, .anim-psp-letters, .anim-light-sweep"
      );
      animatedEls.forEach((el) => {
        el.style.animation = "none";
      });
      void svg.getBoundingClientRect();
      animatedEls.forEach((el) => {
        el.style.animation = "";
      });
    }

    const logoCardWrap = document.querySelector(".logo-card-wrap");
    if (logoCardWrap) {
      logoCardWrap.addEventListener("click", replayLogoAnimation);
    }

    if (document.hidden) {
      const onFirstVisible = () => {
        if (!document.hidden) {
          document.removeEventListener("visibilitychange", onFirstVisible);
          replayLogoAnimation();
        }
      };
      document.addEventListener("visibilitychange", onFirstVisible);
    }

    window.addEventListener("DOMContentLoaded", () => {
      setLanguage("en");
      replayLogoAnimation();
    });
  </script>
</body>
</html>